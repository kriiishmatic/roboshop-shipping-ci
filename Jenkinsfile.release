@Library('roboshop-ci') _

pipeline {

    agent {
        label 'AGENT-1'
    }

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        PROJECT          = 'roboshop'
        SERVICE_NAME     = 'shipping'

        APP_REPO_URL     = 'https://github.com/kriiishmatic/roboshop-shipping-ci.git'
        POM_PATH         = 'pom.xml'

        GITHUB_CREDENTIALS = 'shipping CI github PAT'

        AWS_REGION       = 'us-east-1'
        AWS_ACCOUNT_ID   = '392401698561'

        ECR_REPOSITORY   = 'project-k/shipping'
        ECR_REGISTRY     = '392401698561.dkr.ecr.us-east-1.amazonaws.com'
    }

    stages {

        stage('Validate Merge Event') {
            steps {
                script {
                    echo 'Validating GitHub Pull Request merge event...'

                    if (env.PR_ACTION != 'closed') {
                        error "Invalid PR action: ${env.PR_ACTION}"
                    }

                    if (env.PR_MERGED != 'true') {
                        error "Pull Request was not merged: ${env.PR_MERGED}"
                    }

                    if (env.PR_BASE_BRANCH != 'main') {
                        error "PR target must be main. Received: ${env.PR_BASE_BRANCH}"
                    }

                    if (!(env.MERGE_COMMIT_SHA ==~ /^[0-9a-fA-F]{40}$/)) {
                        error 'Invalid or missing merge commit SHA.'
                    }

                    echo """
                    Merge Event Validated
                    ---------------------
                    PR Action       : ${env.PR_ACTION}
                    PR Merged       : ${env.PR_MERGED}
                    Target Branch   : ${env.PR_BASE_BRANCH}
                    Merge Commit    : ${env.MERGE_COMMIT_SHA}
                    """
                }
            }
        }

        stage('Checkout Merge Commit') {
            steps {
                script {
                    checkout([
                        $class: 'GitSCM',
                        branches: [[name: '*/main']],
                        userRemoteConfigs: [[
                            url: env.APP_REPO_URL,
                            credentialsId: env.GITHUB_CREDENTIALS
                        ]]
                    ])

                    sh '''
                        set -eu

                        echo "Fetching latest main branch..."
                        git fetch origin main

                        echo "Checking out exact merge commit..."
                        git checkout --detach "$MERGE_COMMIT_SHA"

                        ACTUAL_COMMIT=$(git rev-parse HEAD)

                        if [ "$ACTUAL_COMMIT" != "$MERGE_COMMIT_SHA" ]; then
                            echo "ERROR: Checked-out commit does not match webhook commit."
                            exit 1
                        fi

                        echo "Successfully checked out merge commit:"
                        git log -1 --oneline
                    '''

                    env.GIT_COMMIT = env.MERGE_COMMIT_SHA
                    env.GIT_SHORT_COMMIT = env.MERGE_COMMIT_SHA.take(7)
                }
            }
        }

        stage('Setup Java and Maven') {
            steps {
                setupJavaMaven()
            }
        }

        stage('Initialize Release') {
            steps {
                script {
                    initializePipeline()

                    echo """
                    Release Information
                    -------------------
                    Service          : ${env.SERVICE_NAME}
                    Target Branch    : ${env.PR_BASE_BRANCH}
                    Application Ver  : ${env.BUILD_VERSION}
                    Merge Commit     : ${env.GIT_COMMIT}
                    Docker Image Tag : ${env.IMAGE_TAG}
                    ECR Repository   : ${env.ECR_REPOSITORY}
                    """
                }
            }
        }

        stage('Verify Build Environment') {
            steps {
                sh '''
                    set -eu

                    echo "Checking Docker..."
                    docker --version

                    echo "Checking AWS CLI..."
                    aws --version

                    echo "Checking AWS identity..."
                    aws sts get-caller-identity --region "$AWS_REGION"
                '''
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    set -eu

                    IMAGE="$ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG"

                    echo "Building image: $IMAGE"

                    docker build \
                        -t "$IMAGE" \
                        .

                    echo "Docker image built successfully."
                '''
            }
        }

        stage('Authenticate with AWS ECR') {
            steps {
                sh '''
                    set -eu

                    aws ecr get-login-password \
                        --region "$AWS_REGION" |
                    docker login \
                        --username AWS \
                        --password-stdin "$ECR_REGISTRY"
                '''
            }
        }

        stage('Push Image to ECR') {
            steps {
                sh '''
                    set -eu

                    IMAGE="$ECR_REGISTRY/$ECR_REPOSITORY:$IMAGE_TAG"

                    echo "Pushing image: $IMAGE"

                    docker push "$IMAGE"

                    echo "Image pushed successfully."
                '''
            }
        }

        stage('Capture ECR Image Digest') {
            steps {
                script {
                    env.IMAGE_DIGEST = sh(
                        script: '''
                            aws ecr describe-images \
                                --region "$AWS_REGION" \
                                --repository-name "$ECR_REPOSITORY" \
                                --image-ids imageTag="$IMAGE_TAG" \
                                --query 'imageDetails[0].imageDigest' \
                                --output text
                        ''',
                        returnStdout: true
                    ).trim()

                    if (!env.IMAGE_DIGEST ||
                        env.IMAGE_DIGEST == 'None') {
                        error 'Unable to retrieve ECR image digest.'
                    }

                    env.IMAGE_URI = "${env.ECR_REGISTRY}/${env.ECR_REPOSITORY}@${env.IMAGE_DIGEST}"

                    echo """
                    RELEASE SUCCESSFUL
                    ------------------
                    Image Tag     : ${env.IMAGE_TAG}
                    Image Digest  : ${env.IMAGE_DIGEST}
                    Immutable URI : ${env.IMAGE_URI}
                    """
                }
            }
        }
    }

    post {
        success {
            echo "Shipping release completed successfully: ${env.IMAGE_TAG}"
        }

        failure {
            echo 'Shipping release failed. Check the stage logs for details.'
        }

        always {
            script {
                if (env.IMAGE_TAG) {
                    sh(
                        script: """
                            docker image rm \
                                '${env.ECR_REGISTRY}/${env.ECR_REPOSITORY}:${env.IMAGE_TAG}' \
                                || true
                        """,
                        returnStatus: true
                    )
                }
            }
        }
    }
}
